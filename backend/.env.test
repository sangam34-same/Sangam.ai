NODE_ENV=test
MONGO_URI=mongodb://127.0.0.1:27017/sangam_ai_test
JWT_ACCESS_SECRET=test-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=test-refresh-secret-min-32-chars-long
COOKIE_SECRET=test-cookie-secret-min-32-chars-long
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_ISSUER=sangam.ai
JWT_AUDIENCE=sangam.ai
FRONTEND_URL=http://localhost:5173
BCRYPT_SALT_ROUNDS=4
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_DURATION_MS=1800000
MIN_PASSWORD_LENGTH=12
RESET_TOKEN_EXPIRE_MS=900000
RESET_RATE_LIMIT_MAX=3
RESET_RATE_LIMIT_WINDOW_MS=3600000
LOG_LEVEL=silent