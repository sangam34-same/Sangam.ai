# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/sangam_ai

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-min-32-char-access-secret-here
JWT_REFRESH_SECRET=your-min-32-char-refresh-secret-here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_ISSUER=sangam.ai
JWT_AUDIENCE=sangam.ai

# Cookie
COOKIE_SECRET=your-min-32-char-cookie-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_DURATION_MS=1800000

# Password
BCRYPT_SALT_ROUNDS=12
MIN_PASSWORD_LENGTH=12

# Password Reset
RESET_TOKEN_EXPIRE_MS=900000
RESET_RATE_LIMIT_MAX=3
RESET_RATE_LIMIT_WINDOW_MS=3600000

# Email (required for production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@sangam.ai

# Redis (optional in dev, required in production for rate limiting)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info